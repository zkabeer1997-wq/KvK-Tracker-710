# Public browser configuration (staging values only for local development)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only staging credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
MEMBER_SESSION_SECRET=
ADMIN_PASSWORD=

# Kingshot verification adapter
# Default to mock for local development. Do not use an undocumented live endpoint
# until the owner has approved its terms, stability, and rate limits.
KINGSHOT_API_MODE=mock
KINGSHOT_API_BASE_URL=
KINGSHOT_API_KEY=

# Safety guard: server code must reject production data access in preview builds.
K710_ENVIRONMENT=development
